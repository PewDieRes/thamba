{
  "name": "thamba",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint . --max-warnings 0",
    "format": "prettier --write",
    "db:types": "supabase gen types typescript --local --schema public > src/infrastructure/supabase/database.types.ts && prettier --write src/infrastructure/supabase/database.types.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc --project tsconfig.core.json",
    "check:boundaries": "depcruise --config dependency-cruiser.config.cjs src",
    "test:unit": "vitest run --project unit --coverage",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "next": "16.4.6",
    "next-intl": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-check-file": "^3.0.0",
    "fast-check": "^4.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "supabase": "^2.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
